{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": 26,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import a package\n",
    "import re\n",
    "\n",
    "# Defining a regular expression\n",
    "pattern = r\"([A-Z][a-z]*)(\\d*)\"\n",
    "\n",
    "# Defining element-to-mass dictionary\n",
    "mass_dict = {'H': 1., 'C': 12., 'N': 14.0, 'O': 16.0, \"Si\": 28.0, \"Fe\": 56.}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "metadata": {},
   "outputs": [],
   "source": [
    "def chemformula_to_mass(chemical_formula):\n",
    "    \n",
    "    # Extract the element-count pairs from chemical formula\n",
    "    matches = re.findall(pattern, chemical_formula)\n",
    "\n",
    "    # Making an empty dictionary to serve as container\n",
    "    composition = {}\n",
    "    \n",
    "    # Find out the number of occurrences per element and store in composition dictionary\n",
    "    for match in matches:\n",
    "        count = 1\n",
    "        if match[1]:\n",
    "            count = int(match[1])\n",
    "        if match[0] not in composition:\n",
    "            composition[match[0]] = count\n",
    "        else:\n",
    "            composition[match[0]] += count\n",
    "\n",
    "    # For each element in the composition dictionary, multiply the count with its mass and add to total sum\n",
    "    mass = 0.\n",
    "    for element, count in composition.items():\n",
    "\n",
    "        mass += mass_dict[element] * count\n",
    "\n",
    "    # return composition dictionary and computed mass\n",
    "    return composition, mass"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The mass of :  C27H46O is  386.0\n"
     ]
    }
   ],
   "source": [
    "# Assign as chemical formula (a string) to the variable chem_formula.\n",
    "# Change this string according to the molecule you are interested in.\n",
    "chem_formula = \"C27H46O\"\n",
    "\n",
    "# Make a function call to the chemformula_to_mass function with the variable chem_formula as input argument\n",
    "# The values returned from the function are assigned to the variable names composition and mass \n",
    "composition, mass = chemformula_to_mass(chem_formula)\n",
    "\n",
    "# Print the values tagged by the variables chem_formula and mass\n",
    "print(\"The molar mass of : \", chem_formula, \"is \", mass, r"g mol^$-1$") "
   ]
  }
 ],
